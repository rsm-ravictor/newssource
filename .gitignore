# Secrets — never commit
.env

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Local pipeline data (future stages) — nothing here should ever be published
data/tenant_intel.db
logs/

# Build output is committed on purpose (GitHub Pages serves docs/),
# but the intermediate dist/ copy is not.
dist/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Real watchlists are PRIVATE: they are the portfolio and competitor lists.
# This repo is public, so only the *.example.txt templates are committed.
data/watchlists/*.txt
!data/watchlists/*.example.txt

# Same reason for the hand-maintained rosters at the root, which are now the
# point of reference for live runs and carry the full tenant and competitor lists.
tenant-list.md
competitor-list.md

# Reviewer notes from the /reference page are written about real tenants and
# competitors, and they feed the judging prompt.
data/notes/

# Live-run snapshots contain real tenant/competitor news. Publishing docs/ would
# make them public - keep the fictional sample committed and snapshot locally.
data/live_*.json

# The .md rosters under data/watchlists/ are real lists too, not just the .txt ones.
data/watchlists/*.md

# Word lock files, created whenever a .docx is open
~$*

# History store - real findings about real tenants, and WAL sidecars
*.db
*.db-wal
*.db-shm

# Briefings exported from a live run (the "Copy HTML" / saved-email files). Real
# tenant and competitor news, same reason as data/live_*.json above.
*Intel Briefing*.html
