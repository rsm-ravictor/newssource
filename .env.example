# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM (TritonAI, UCSD's OpenAI-compatible proxy) -------------------------
# Generate a key at https://tritonai-api.ucsd.edu/ with your UCSD login.
TRITONAI_API_KEY=

# --- Web search (used by the future search stage) ---------------------------
# https://app.tavily.com/
TAVILY_API_KEY=

# --- History store (optional) ----------------------------------------------
# Unset: the store is a local SQLite file at data/history.db, and nothing here
# is needed. Set: the same tables live in Postgres instead - paste the pooled
# connection string from your Neon project's dashboard. It is a credential;
# .env is gitignored, keep it that way.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Email delivery (used by the future digest-send stage) ------------------
# Gmail: 2-Step Verification -> App passwords -> Mail
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_RECIPIENTS=
