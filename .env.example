# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM (TritonAI, UCSD's OpenAI-compatible proxy) -------------------------
# Generate a key at https://tritonai-api.ucsd.edu/ with your UCSD login.
TRITONAI_API_KEY=

# --- Web search (used by the future search stage) ---------------------------
# https://app.tavily.com/
TAVILY_API_KEY=

# --- Email delivery (used by the future digest-send stage) ------------------
# Gmail: 2-Step Verification -> App passwords -> Mail
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_RECIPIENTS=
